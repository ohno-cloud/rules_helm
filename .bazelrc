# Use registered protobuf toolchains rather than the legacy built-in compiler.
# Stardoc needs protoc to build its renderer; prefer the prebuilt release binary
# to avoid compiling protoc (and requiring a working host C/C++ SDK) locally.
# This workspace's development settings are not inherited by chart consumers.
build --incompatible_enable_proto_toolchain_resolution
build --@protobuf//bazel/toolchains:prefer_prebuilt_protoc=true
