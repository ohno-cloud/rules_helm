load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "pinhelmlock_lib",
    srcs = ["main.go"],
    importpath = "github.com/dbanetto/rules_helm/tools/pinhelmlock",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "pinhelmlock",
