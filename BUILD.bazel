load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

exports_files([
    "extensions.bzl",
    "helm.bzl",
    "repo.bzl",
    "providers.bzl",
])

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

alias(
    name = "gazelle-all",
    actual = "//tools:gazelle-all",
)

# gazelle:proto package
alias(
    name = "gazelle",
    actual = "//tools:gazelle",
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":helm",
        ":repo",
    ],
)

bzl_library(
    name = "helm",
    srcs = ["helm.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":providers",
        ":rules",
        ":toolchain",
    ],
)

bzl_library(
    name = "repo",
    srcs = ["repo.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//private:toolchain_repo",
        "//private:versions",
        "@bazel_tools//tools/build_defs/repo:cache.bzl",
        "@bazel_tools//tools/build_defs/repo:http.bzl",
        "@bazel_tools//tools/build_defs/repo:utils.bzl",
    ],
)

bzl_library(
    name = "rules",
    srcs = ["rules.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":providers",
        "//private:oci",
    ],
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    visibility = ["//visibility:public"],
    deps = [":providers"],
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
    visibility = ["//visibility:public"],
)
