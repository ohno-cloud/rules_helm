module(
    name = "rules_helm",
    version = "0.5.0",
    bazel_compatibility = [">=9.1.0"],
)

helmlock_repository = use_repo_rule("//private:resolver.bzl", "helmlock_repository")

helmlock_repository(name = "rules_helm_resolver")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

# Development-only tooling for building the resolver, tests, and generated BUILD files.
bazel_dep(name = "rules_go", version = "0.61.0", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.47.0", dev_dependency = True)
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.7.1", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)

# Use prebuilt protoc toolchains for Stardoc instead of compiling protoc locally.
bazel_dep(name = "protobuf", version = "36.2", dev_dependency = True)

helm_configure = use_extension("@rules_helm//:extensions.bzl", "helm_configure")
use_repo(helm_configure, "sh_helm_get_toolchains")

register_toolchains("@sh_helm_get_toolchains//:all")

# ========================================================================
# Go Lang
# ========================================================================
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps.from_file(go_mod = "//:go.mod")

# All *direct* Go dependencies of the module have to be listed explicitly.
use_repo(
    go_deps,
    "com_github_google_go_containerregistry",
    "in_gopkg_yaml_v3",
)
